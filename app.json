{
  "id": "dev.rymenants.novy",
  "version": "0.2.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": {
    "en": "Novy BLE (Cloud / Pureline Pro)",
    "nl": "Novy BLE (Cloud / Pureline Pro)"
  },
  "description": {
    "en": "Control your Novy Cloud or Pureline Pro extractor hood over Bluetooth",
    "nl": "Bedien je Novy Cloud- of Pureline Pro-dampkap via Bluetooth"
  },
  "category": ["climate"],
  "permissions": ["homey:wireless:ble"],
  "brandColor": "#1c1c1c",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Geert Rymenants",
    "email": "rymenants.geert@me.com"
  },
  "source": "https://github.com/bwynants/hass-purelinepro",
  "flow": {
    "triggers": [
      {
        "id": "grease_dirty_true",
        "title": {
          "en": "The grease filter needs cleaning",
          "nl": "Het vetfilter moet gereinigd worden"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hood-fan"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "grease_dirty",
        "title": {
          "en": "Grease filter !{{is|isn't}} dirty",
          "nl": "Vetfilter !{{is|is niet}} vuil"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hood-fan"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "press_power",
        "title": {
          "en": "Press the power button",
          "nl": "Druk op de power-toets"
        },
        "hint": {
          "en": "Same as the power button on the remote: toggles the hood.",
          "nl": "Zoals de power-toets op de afstandsbediening: schakelt de kap om."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hood-fan"
          }
        ]
      },
      {
        "id": "start_boost",
        "title": {
          "en": "Start boost (full speed)",
          "nl": "Start boost (volle kracht)"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hood-fan"
          }
        ]
      },
      {
        "id": "start_run_out",
        "title": {
          "en": "Start run-out mode",
          "nl": "Start de uitloopstand"
        },
        "hint": {
          "en": "Dims the light to ambient, lowers the fan to its switch-off speed and turns it off after 5 minutes (30 in recirculation mode).",
          "nl": "Dimt het licht naar sfeerstand, verlaagt de ventilator naar de uitloopsnelheid en schakelt na 5 minuten uit (30 in recirculatiestand)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hood-fan"
          }
        ]
      }
    ]
  },
  "capabilities": {
    "recirculation": {
      "type": "boolean",
      "title": {
        "en": "Recirculation",
        "nl": "Recirculatie"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "insights": false
    },
    "alarm_grease": {
      "type": "boolean",
      "title": {
        "en": "Grease filter dirty",
        "nl": "Vetfilter vuil"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    }
  },
  "drivers": [
    {
      "id": "hood-fan",
      "name": {
        "en": "Novy hood — fan",
        "nl": "Novy dampkap — ventilator"
      },
      "class": "fan",
      "capabilities": ["onoff", "dim", "recirculation", "alarm_grease", "button.reset_grease"],
      "capabilitiesOptions": {
        "dim": {
          "title": {
            "en": "Fan speed",
            "nl": "Ventilatorsnelheid"
          }
        },
        "button.reset_grease": {
          "maintenanceAction": true,
          "title": {
            "en": "Reset grease filter counter",
            "nl": "Vetfilterteller resetten"
          },
          "desc": {
            "en": "Resets the grease filter cleaning reminder after cleaning the filters.",
            "nl": "Zet de vetfilter-herinnering terug op nul nadat je de filters hebt gereinigd."
          }
        }
      },
      "connectivity": ["ble"],
      "platforms": ["local"],
      "images": {
        "small": "/drivers/hood-fan/assets/images/small.png",
        "large": "/drivers/hood-fan/assets/images/large.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "hood-light",
      "name": {
        "en": "Novy hood — light",
        "nl": "Novy dampkap — verlichting"
      },
      "class": "light",
      "capabilities": ["onoff", "dim", "light_temperature"],
      "connectivity": ["ble"],
      "platforms": ["local"],
      "images": {
        "small": "/drivers/hood-light/assets/images/small.png",
        "large": "/drivers/hood-light/assets/images/large.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    }
  ]
}
